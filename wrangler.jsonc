{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "bento-docs",
    "compatibility_date": "2026-08-03",
    "workers_dev": false,
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
    },
    "routes": [{ "pattern": "docs.bentobot.xyz", "custom_domain": true }],
}
