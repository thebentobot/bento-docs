{
    "name": "bento-docs",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26.13.1"
    },
    "scripts": {
        "sync": "node scripts/sync-commands.mjs",
        "predev": "npm run sync",
        "dev": "astro dev",
        "prebuild": "npm run sync",
        "build": "astro check && astro build",
        "check:links": "node scripts/check-links.mjs",
        "preview": "astro preview",
        "pretest": "npm run sync",
        "test": "vitest run",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "deploy": "wrangler deploy"
    },
    "dependencies": {
        "@astrojs/starlight": "0.43.1",
        "@skyra/discord-components-core": "4.0.2",
        "astro": "7.4.12",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@astrojs/sitemap": "3.7.5",
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@typescript-eslint/parser": "8.73.0",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-astro": "3.2.1",
        "globals": "17.14.0",
        "prettier": "3.10.1",
        "prettier-plugin-astro": "1.1.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "vitest": "5.1.1",
        "wrangler": "4.164.0"
    }
}
